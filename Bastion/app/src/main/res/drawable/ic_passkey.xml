<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- 盾牌：鲜亮蓝渐变（与 app 品牌一致） -->
    <path
        android:pathData="M12 2 L20 5.3 L20 12 Q20 18 12 22 Q4 18 4 12 L4 5.3 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="5" android:startY="2"
                android:endX="19" android:endY="22"
                android:startColor="#5FB0F2"
                android:centerColor="#1E6FC0"
                android:endColor="#0A2A4D" />
        </aapt:attr>
    </path>
    <!-- 盾牌顶部高光：玻璃反射 -->
    <path
        android:pathData="M12 2 L20 5.3 L20 8.6 Q12 6.6 4 8.6 L4 5.3 Z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.18" />
    <!-- 盾牌轮廓光：鲜蓝描边 -->
    <path
        android:pathData="M12 2 L20 5.3 L20 12 Q20 18 12 22 Q4 18 4 12 L4 5.3 Z"
        android:fillColor="@android:color/transparent"
        android:strokeColor="#9FD4FF"
        android:strokeAlpha="0.65"
        android:strokeWidth="1"
        android:strokeLineJoin="round" />
    <!-- 金色锁孔：圆 -->
    <path
        android:pathData="M9.8 10.4 a2.2 2.2 0 1 0 4.4 0 a2.2 2.2 0 1 0 -4.4 0 Z"
        android:fillColor="#F5B942" />
    <!-- 金色锁孔：锁芯 -->
    <path
        android:pathData="M11 12.2 L13 12.2 L14 16 L10 16 Z"
        android:fillColor="#F5B942" />
</vector>
