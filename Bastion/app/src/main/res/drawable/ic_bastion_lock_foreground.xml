<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 接触阴影：玻璃板上的投影，制造悬浮感 -->
    <path
        android:pathData="M54 28 L80 38 L80 56 Q80 75 54 88 Q28 75 28 56 L28 38 Z"
        android:fillColor="#08233F"
        android:fillAlpha="0.16" />

    <!-- 盾牌：鲜亮蓝渐变 -->
    <path
        android:pathData="M54 26 L80 36 L80 56 Q80 74 54 86 Q28 74 28 56 L28 36 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="30" android:startY="26"
                android:endX="78" android:endY="86"
                android:startColor="#5FB0F2"
                android:centerColor="#1E6FC0"
                android:endColor="#0A2A4D" />
        </aapt:attr>
    </path>

    <!-- 盾牌顶部高光：玻璃反射 -->
    <path
        android:pathData="M54 26 L80 36 L80 47 Q54 41 28 47 L28 36 Z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.20" />

    <!-- 盾牌轮廓光：鲜蓝描边，顶部最亮 -->
    <path
        android:pathData="M54 26 L80 36 L80 56 Q80 74 54 86 Q28 74 28 56 L28 36 Z"
        android:fillColor="@android:color/transparent"
        android:strokeColor="#9FD4FF"
        android:strokeAlpha="0.85"
        android:strokeWidth="1.5"
        android:strokeLineJoin="round" />

    <!-- 金色锁孔：圆（宝石感径向渐变） -->
    <path
        android:pathData="M45.5 50 a8.5 8.5 0 1 0 17 0 a8.5 8.5 0 1 0 -17 0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="52" android:centerY="47"
                android:gradientRadius="13"
                android:startColor="#FFEFC4"
                android:centerColor="#F5B942"
                android:endColor="#B9760F" />
        </aapt:attr>
    </path>

    <!-- 金色锁孔：锁芯 -->
    <path
        android:pathData="M49 57 L59 57 L63 72 L45 72 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="52" android:centerY="60"
                android:gradientRadius="16"
                android:startColor="#FFE6A8"
                android:centerColor="#F5B942"
                android:endColor="#B9760F" />
        </aapt:attr>
    </path>

    <!-- 锁孔高光点 -->
    <path
        android:pathData="M50 46.5 a2.6 1.8 0 1 0 3.6 0 a2.6 1.8 0 1 0 -3.6 0 Z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.6" />

</vector>
