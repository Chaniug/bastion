<?xml version="1.0" encoding="utf-8"?>
<!-- 图标背景：MagicOS 桌面"深色玻璃卡"风格（对齐 QQ/微信 桌面图标观感）。
     QQ/微信 在 MagicOS 桌面上的图标卡都是"深灰半透明玻璃"——能透出后面壁纸
     的模糊色彩，顶部一抹亮营造玻璃反光，整体像"一片深色玻璃浮在桌面上"。

     选深灰而非深蓝的原因：
     - 蓝盾本身就是蓝色，背景再蓝会"蓝撞蓝"压垮前景；
     - 深灰作为中性背景，让蓝盾金锁成为视觉焦点（与 QQ 企鹅在灰卡上
       一样醒目）。

     与之前"半透明白玻璃"的区别：白色玻璃在浅背景上像白贴纸，达不到
     QQ/微信 那种"沉着的卡片感"；深灰玻璃在任意背景下都呈现一致的
     深色卡片观感，且能透出桌面/壁纸的色彩细节。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 底层：60% 深灰半透明玻璃板 -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="#992F2F2F" />
        </shape>
    </item>

    <!-- 顶层：顶部高光渐变（vertical，上亮下透），营造玻璃反光 -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#88FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>

</layer-list>