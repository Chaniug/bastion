<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 磨砂玻璃主体：半透明白色径向渐变（左上偏亮，模拟光源） -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.4"
                android:centerY="0.32"
                android:gradientRadius="92"
                android:startColor="#59FFFFFF"
                android:centerColor="#3CF2F4F7"
                android:endColor="#2CE2E6EA" />
        </shape>
    </item>

    <!-- 玻璃边缘反光：白色半透明描边 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="2dp"
                android:color="#B4FFFFFF" />
        </shape>
    </item>

</layer-list>
