<?xml version="1.0" encoding="utf-8"?>
<!-- 图标背景：MagicOS 10 风格的"玻璃通透"图标底板。
     半透明白底色 + 顶部高光渐变，让 adaptive-icon 在 SplashScreen 圆形舞台
     和桌面 launcher 圆角矩形容器中，都呈现"一片玻璃浮在背景上"的通透感——
     而不是纯透明（被 OEM 兜底成黑色圆环）或纯白实底（变成白贴纸）。

     设计语言：
     - 底色：20% 半透明白（#33FFFFFF），让 splash / 壁纸底色自然透出
     - 顶部高光：53% 白 → 透明 的垂直渐变，营造"玻璃反光"
     - 形状：22dp 圆角矩形，适配标准圆形 mask 与 MagicOS 大圆角矩形 mask

     日间/夜间统一：白色玻璃在浅背景上呈现淡雅磨砂感，在深背景上呈现明显玻璃片，
     与 MagicOS 10 桌面图标的视觉语言一致。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 底层：半透明白玻璃板 -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <solid android:color="#33FFFFFF" />
        </shape>
    </item>

    <!-- 顶层：顶部高光渐变（vertical，上亮下透） -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="22dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#88FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>

</layer-list>