-- Phase 3 一并建表（业务接线留 Phase 5）：KDBX 远端同步源（如 OneDrive）。

CREATE TABLE keepass_remote_sources (
    id INTEGER NOT NULL PRIMARY KEY,
    database_id INTEGER NOT NULL,
    provider TEXT NOT NULL DEFAULT 'ONEDRIVE',
    remote_path TEXT NOT NULL DEFAULT '',
    auth_type TEXT NOT NULL DEFAULT 'OAUTH',
    remote_url TEXT,
    refresh_token TEXT,
    access_token TEXT,
    token_expires_at INTEGER,
    created_at INTEGER NOT NULL DEFAULT 0,
    updated_at INTEGER NOT NULL DEFAULT 0
);

insert:
INSERT INTO keepass_remote_sources (id, database_id, provider, remote_path, auth_type, remote_url, refresh_token, access_token, token_expires_at, created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectAll:
SELECT * FROM keepass_remote_sources ORDER BY id ASC;

selectById:
SELECT * FROM keepass_remote_sources WHERE id = ?;

selectByDatabase:
SELECT * FROM keepass_remote_sources WHERE database_id = ?;

update:
UPDATE keepass_remote_sources SET database_id = ?, provider = ?, remote_path = ?, auth_type = ?, remote_url = ?, refresh_token = ?, access_token = ?, token_expires_at = ?, updated_at = ?
WHERE id = ?;

deleteById:
DELETE FROM keepass_remote_sources WHERE id = ?;
