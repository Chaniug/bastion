-- Phase 3 完整 schema：password_entries 与 PasswordEntry 模型对齐（id 为 INTEGER 主键）。
-- 其余 7 张表及 preferences 在各自的 .sq 文件中定义。

CREATE TABLE password_entries (
    id INTEGER NOT NULL PRIMARY KEY,
    title TEXT NOT NULL DEFAULT '',
    website TEXT,
    username TEXT,
    encrypted_password TEXT,
    notes TEXT,
    is_favorite INTEGER NOT NULL DEFAULT 0,
    soft_deleted INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL DEFAULT 0,
    updated_at INTEGER NOT NULL DEFAULT 0,
    bitwarden_vault_id INTEGER,
    bitwarden_cipher_id TEXT,
    bitwarden_folder_id TEXT,
    bitwarden_revision_date TEXT,
    bitwarden_local_modified INTEGER NOT NULL DEFAULT 0,
    keepass_database_id INTEGER,
    keepass_entry_uuid TEXT,
    keepass_group_uuid TEXT
);

insert:
INSERT INTO password_entries (
    id, title, website, username, encrypted_password, notes,
    is_favorite, soft_deleted, created_at, updated_at,
    bitwarden_vault_id, bitwarden_cipher_id, bitwarden_folder_id,
    bitwarden_revision_date, bitwarden_local_modified,
    keepass_database_id, keepass_entry_uuid, keepass_group_uuid
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectAll:
SELECT * FROM password_entries;

selectById:
SELECT * FROM password_entries WHERE id = ?;

selectByBitwardenCipher:
SELECT * FROM password_entries WHERE bitwarden_cipher_id = ? AND bitwarden_vault_id = ?;

selectAllByVault:
SELECT * FROM password_entries WHERE bitwarden_vault_id = ? AND soft_deleted = 0
ORDER BY updated_at DESC;

selectLocalModifiedByVault:
SELECT * FROM password_entries WHERE bitwarden_vault_id = ? AND bitwarden_local_modified = 1;

countByVault:
SELECT COUNT(*) FROM password_entries WHERE bitwarden_vault_id = ?;

update:
UPDATE password_entries SET
    title = ?, website = ?, username = ?, encrypted_password = ?, notes = ?,
    is_favorite = ?, soft_deleted = ?, updated_at = ?,
    bitwarden_vault_id = ?, bitwarden_cipher_id = ?, bitwarden_folder_id = ?,
    bitwarden_revision_date = ?, bitwarden_local_modified = ?,
    keepass_database_id = ?, keepass_entry_uuid = ?, keepass_group_uuid = ?
WHERE id = ?;

deleteById:
DELETE FROM password_entries WHERE id = ?;

deleteByCipherId:
DELETE FROM password_entries WHERE bitwarden_vault_id = ? AND bitwarden_cipher_id = ?;

deleteAllBitwardenByVault:
DELETE FROM password_entries WHERE bitwarden_vault_id = ? AND bitwarden_local_modified = 0;

deleteAllByVault:
DELETE FROM password_entries WHERE bitwarden_vault_id = ?;

deleteNotIn:
DELETE FROM password_entries
WHERE bitwarden_vault_id = ? AND bitwarden_cipher_id IS NOT NULL
  AND bitwarden_cipher_id NOT IN ? AND bitwarden_local_modified = 0;
