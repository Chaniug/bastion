CREATE TABLE bitwarden_conflict_backups (
    id INTEGER NOT NULL PRIMARY KEY,
    vault_id INTEGER NOT NULL,
    entry_id INTEGER,
    cipher_id TEXT NOT NULL,
    conflict_type TEXT NOT NULL DEFAULT 'CONCURRENT_EDIT',
    server_snapshot_json TEXT NOT NULL DEFAULT '',
    local_snapshot_json TEXT NOT NULL DEFAULT '',
    resolved INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL DEFAULT 0
);

insert:
INSERT INTO bitwarden_conflict_backups (id, vault_id, entry_id, cipher_id, conflict_type, server_snapshot_json, local_snapshot_json, resolved, created_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

selectAll:
SELECT * FROM bitwarden_conflict_backups ORDER BY id ASC;

selectById:
SELECT * FROM bitwarden_conflict_backups WHERE id = ?;

selectByVaultUnresolved:
SELECT * FROM bitwarden_conflict_backups WHERE vault_id = ? AND resolved = 0;

markResolved:
UPDATE bitwarden_conflict_backups SET resolved = 1 WHERE id = ?;

deleteById:
DELETE FROM bitwarden_conflict_backups WHERE id = ?;
